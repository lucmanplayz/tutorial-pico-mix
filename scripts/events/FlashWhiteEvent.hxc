import funkin.play.event.SongEvent;
import funkin.play.PlayState;
import flixel.FlxG;
import flixel.util.FlxColor;
import funkin.Conductor;

//CODE BY BIT https://www.youtube.com/@mq-bit - https://gamebanana.com/members/4724027

class FlashWhiteEvent extends SongEvent
{
    public function new() { super("FlashWhite"); }

    override function getTitle() { return "FlashWhite"; }

    override function handleEvent(data) {
        if (PlayState.instance == null || PlayState.instance.camGame == null) return;

        var duration:Float = data.getFloat("v1") ?? 4;
        var opacity:Float = data.getFloat("v2") ?? 1.0;
        var dur:Float = (Conductor.instance.stepLengthMs * duration) / 1000;
        
        PlayState.instance.camGame.flash(0xFFFFFFFF, dur, true, opacity);
    }

    override function getEventSchema()
    {
        return [
            { name: "v1", title: "Duration", defaultValue: 4, step:0.5, type: "float" },
            { name: "v2", title: "Opacity", defaultValue: 1, step:0.25, type: "float" }
        ];
    }
}