import funkin.play.event.SongEvent;
import funkin.play.PlayState;
import flixel.FlxG;

//CODE BY BIT https://www.youtube.com/@mq-bit - https://gamebanana.com/members/4724027

class AddCameraZoomEvent extends SongEvent
{
    function new() { super('AddCameraZoomEvent'); }
    override function getTitle() { return "Add Camera Zoom"; }

    override function handleEvent(data:Dynamic)
    {
        var gameZom:Float = data.getFloat('gameZoom');
        var hudZom:Float = data.getFloat('hudZoom');

        if (PlayState.instance.cameraZoomTween == null || PlayState.instance.cameraZoomTween != null && !PlayState.instance.cameraZoomTween.active) PlayState.instance.cameraBopMultiplier += gameZom;
        PlayState.instance.camHUD.zoom += hudZom;
    }

    override function getEventSchema()
    {
        return [
            {
                name: "gameZoom",
                title: "game", 
                defaultValue:0.05, min:-2.0, max:0.5, step:0.05, type:"float", units:'+x'
            },
            {
                name: "hudZoom",
                title: "hud",
                defaultValue:0.025, min:-2.0, max:0.5, step:0.025, type:"float", units:'+x'
            }
        ];
    }
}