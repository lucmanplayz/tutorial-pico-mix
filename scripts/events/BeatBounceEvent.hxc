import funkin.play.event.SongEvent;
import funkin.play.PlayState;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import funkin.Preferences;
import funkin.Conductor;

//CODE BY BIT https://www.youtube.com/@mq-bit - https://gamebanana.com/members/4724027

class BeatBounceEvent extends SongEvent {
    public function new() { super("Beat Bounce"); }
    override function getTitle() { return "Beat Bounce"; }

    override function handleEvent(data) {
        var mod = ModuleHandler.getModule('BeatBounceModule');
        var enabled = data.getBool('v1');
        var mult = data.getFloat('v2');

        mod.bounceActive = enabled;
        mod.bounceMultiplier = mult;

        if(!enabled && PlayState.instance != null) {
            var cam = PlayState.instance.camHUD.scroll;
            var sec:Float = (Conductor.instance.stepLengthMs * 4) / 1000;
            FlxTween.cancelTweensOf(cam, ['y']);
            FlxTween.tween(cam, { y: 0 }, sec, { ease: FlxEase.circOut });
        }
    }

    override function getEventSchema() {
        return [
            { name:'v1', title:'Enabled', defaultValue:true, type:"bool"},
            { name:'v2', title:'Multiplier', defaultValue:1.0, min:0.1, max:5.0, step:0.1,
              type:"float", units:'x'}
        ];
    }
}

class BeatBounceModule extends Module {
    public var bounceActive:Bool = false;
    public var bounceMultiplier:Float = 1.0;
    public var baseBounce:Float = 14.0;
    public var originalCamY:Float = 0;

    override function onSongStart(_) {
        bounceActive = false;
        bounceMultiplier = 1.0;
        originalCamY = 0;
    }

    function onStepHit(evt:Dynamic) {
        if(!bounceActive || PlayState.instance == null) return;
        var cam = PlayState.instance.camHUD.scroll;
        var bounce:Float = Preferences.downscroll ? (baseBounce) : (-baseBounce);
        var bouncep = bounce * bounceMultiplier;

        if(evt.step % 4 == 0) tweenCamHUD(cam, originalCamY + bouncep, 2, FlxEase.circOut);
        if(evt.step % 4 == 2) tweenCamHUD(cam, 0, 2, FlxEase.quartIn);
    }

    function tweenCamHUD(cam:Dynamic, tgtY:Float, dur:Float, ease:Dynamic) {
        if(cam == null) return;
        var sec:Float = (Conductor.instance.stepLengthMs * dur) / 1000;
        FlxTween.cancelTweensOf(cam, ['y']);
        FlxTween.tween(cam, { y: tgtY }, sec, { ease: ease });
    }

    function onSongRetry(e) { resetBeatBounce(); }
    function onDestroy(e) { resetBeatBounce(); }

    function resetBeatBounce() {
        var ps = PlayState.instance;
        if(ps != null) {
            var cam = ps.camHUD.scroll;
            if(cam != null) {
                FlxTween.cancelTweensOf(cam, ['y']);
                cam.y = 0;
            }
        }

        bounceActive = false;
        bounceMultiplier = 1.0;
        originalCamY = 0;
    }
}